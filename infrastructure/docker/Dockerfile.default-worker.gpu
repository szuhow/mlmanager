# Default Worker GPU - General purpose worker with GPU support
FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    libffi-dev \
    libopencv-dev \
    python3-opencv \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set work directory
WORKDIR /app

# Copy and install Python dependencies
COPY infrastructure/requirements/default.txt /app/requirements.txt

# Install default dependencies with GPU support (PyTorch already in base image)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip cache purge

# Copy application code
COPY core/ /app/core/
COPY infrastructure/env/ /app/infrastructure/env/

# Ensure core/data directories exist
RUN mkdir -p /app/core/data/{logs,media,models}

# Default command for default worker
CMD ["celery", "-A", "core.config", "worker", "--loglevel=info", "--concurrency=4", "--queues=default"]

FROM python:3.10-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    libsqlite3-dev \
    libffi-dev \
    libssl-dev \
    libopencv-dev \
    python3-opencv \
    git \
    curl \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser -u 1000 appuser

# Set work directory
WORKDIR /app

# Copy requirements
COPY infrastructure/requirements/base.txt /app/requirements/base.txt
COPY infrastructure/requirements/prod.txt /app/requirements/prod.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements/prod.txt

# Install PyTorch CPU version
RUN pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# Install MONAI and other ML libraries
RUN pip install monai[all] mlflow scikit-learn matplotlib seaborn opencv-python-headless

# Install Celery and Redis
RUN pip install celery[redis] flower

# Copy project
COPY . /app/

# Create necessary directories and set ownership
RUN mkdir -p /app/core/data/logs /app/core/data/media /app/core/data/static /app/core/data/models \
    /app/core/staticfiles /app/core/static && \
    chown -R appuser:appuser /app && \
    chmod -R 755 /app/core/staticfiles && \
    rm -rf /app/core/staticfiles/*

# Set permissions
RUN chmod +x /app/core/manage.py

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Default command
CMD ["python", "core/manage.py", "runserver", "0.0.0.0:8000"]

FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app/core

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    libsqlite3-dev \
    libffi-dev \
    libssl-dev \
    libopencv-dev \
    python3-opencv \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Copy requirements
COPY infrastructure/requirements/base.txt /app/requirements/base.txt
COPY infrastructure/requirements/prod.txt /app/requirements/prod.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements/prod.txt

# Install MONAI and other ML libraries
RUN pip install monai[all] mlflow scikit-learn matplotlib seaborn opencv-python-headless

# Install Celery and Redis
RUN pip install celery[redis] flower

# Copy project
COPY . /app/

# Create necessary directories
RUN mkdir -p /app/data/logs /app/data/media /app/data/static /app/data/models

# Set permissions
RUN chmod +x /app/core/manage.py

# Expose port
EXPOSE 8000

# Default command
CMD ["python", "core/manage.py", "runserver", "0.0.0.0:8000"]

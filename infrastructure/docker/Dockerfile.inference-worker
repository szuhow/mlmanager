# Inference Worker - Optimized for model inference
FROM python:3.10-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

# Install minimal system dependencies for inference
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    libffi-dev \
    libopencv-dev \
    python3-opencv \
    sudo \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser -u 1000 appuser

# Set work directory
WORKDIR /app

# Copy and install Python dependencies for inference
COPY infrastructure/requirements/inference.txt /app/requirements/inference.txt

# Install inference dependencies (lighter than training)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements/inference.txt && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir opencv-python-headless Pillow numpy && \
    pip cache purge

# Copy application code
COPY core/ /app/core/
COPY infrastructure/env/ /app/infrastructure/env/

# Ensure core/data directories exist and set ownership
RUN mkdir -p /app/core/data/{logs,media,models,inference_results} && \
    chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Default command for inference worker
CMD ["celery", "-A", "core.config", "worker", "--loglevel=info", "--concurrency=2", "--queues=inference", "--hostname=inference-worker@%h"]

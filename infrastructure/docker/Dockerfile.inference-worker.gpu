# Inference Worker GPU - Optimized for model inference with GPU support
FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

# Install minimal system dependencies for inference
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    libffi-dev \
    libopencv-dev \
    python3-opencv \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set work directory
WORKDIR /app

# Copy and install Python dependencies for inference
COPY infrastructure/requirements/inference.txt /app/requirements/inference.txt

# Install inference dependencies with GPU support (using base PyTorch from image)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements/inference.txt && \
    pip install --no-cache-dir opencv-python-headless Pillow numpy && \
    pip cache purge

# Copy application code
COPY core/ /app/core/
COPY infrastructure/env/ /app/infrastructure/env/

# Ensure core/data directories exist
RUN mkdir -p /app/core/data/{logs,media,models,inference_results}

# Default command for inference worker
CMD ["celery", "-A", "core.config", "worker", "--loglevel=info", "--concurrency=2", "--queues=inference"]
